MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 146d4770de626e347adb2af1fed31305, type: 3}
  m_Name: EndingTV Dialogue
  m_EditorClassIdentifier: 
  IsThoughts: 0
  DialogueLines:
  - ColorType: 2
    DisplayTime: 6
    Text: "...I was terrified the whole time. I just couldn\u2019t pull myself together."
  - ColorType: 2
    DisplayTime: 7
    Text: And this is where my little story comes back in. I failed, so I had to
      destroy it.
  - ColorType: 9
    DisplayTime: 5
    Text: Wait, destroy what? What are you talking about now?
  - ColorType: 2
    DisplayTime: 7
    Text: "Ugh, the story. I\u2019m not going to repeat it, I\u2019m sure the folks
      at home remember."
  - ColorType: 9
    DisplayTime: 3
    Text: Ah, right, okay...
  - ColorType: 2
    DisplayTime: 3
    Text: So, I killed it. Crushed it.
  - ColorType: 2
    DisplayTime: 3
    Text: But it came at a price.
  - ColorType: 2
    DisplayTime: 7
    Text: Sometimes, instead of facing something, we desperately try to bury it and
      forget.
  - ColorType: 2
    DisplayTime: 4
    Text: But that can be even more self-destructive...
