MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 146d4770de626e347adb2af1fed31305, type: 3}
  m_Name: HollowpineMemory Dialogue
  m_EditorClassIdentifier: 
  IsThoughts: 0
  DialogueLines:
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: You were right, Hollowpine is wonderful...
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 8
    Text: Yeah, it's absolutely magical.
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: "When we get our own place someday, \nit has to be in pine woods like these."
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 8
    Text: "I've never pictured it any other way. \nThe more remote, the better."
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: "Let's not get carried away. The outskirts \nof a small town would do just
      fine..."
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: "We\u2019ll put my piano in the living room, and..."
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: "Oh! Isn't that a pileated woodpecker? \nChris, quick, the camera!"
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 8
    Text: Got it, got it...
  - IsEvent: 1
    Event: {fileID: 11400000, guid: aaf9674e48555ea48babff5d29361306, type: 2}
    ColorType: 8
    Text: "Not nice enough to hang in the living room, \nbut it\u2019ll do for the
      bathroom..."
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: So? Did you get it?
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 8
    Text: Hold on...
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 8
    Text: Ah, no, it already flew off.
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: Let me see.
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 1
    Text: It came out pretty nice.
  - IsEvent: 0
    Event: {fileID: 0}
    ColorType: 8
    Text: "Not nice enough to hang in the living room, \nbut it\u2019ll do for the
      bathroom..."
