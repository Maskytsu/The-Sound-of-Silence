  m_Script: {fileID: 11500000, guid: 146d4770de626e347adb2af1fed31305, type: 3}
  m_Name: MarketMemory Dialogue
  m_EditorClassIdentifier: 
  IsThoughts: 0
  DialogueLines:
  - ColorType: 7
    Text: Mommy, Mommy... Can I get this one? Pleeease!
  - ColorType: 1
    Text: "It looks horrible. Do you really want this one? \nI thought you didn\u2019t
      like red ones."
  - ColorType: 8
    Text: Oh, come on. It's pretty cool. And big.
  - ColorType: 7
    Text: See, Mom? Dad likes it! Pleeease! It's huge!
  - ColorType: 1
    Text: "What matters is whether you like it, Harry. We promised you \ncould pick
      something, so it might as well be this one."
  - ColorType: 7
    Text: Yaaay! Thank you, thank you, thank you!
  - ColorType: 1
    Text: Although it's a bit over the budget we agreed on...
  - ColorType: 8
    Text: We'll figure something out.
  - ColorType: 1
    Text: We'll figure something out.
